# Port the server listens on
PORT=3001

# Comma-separated list of origins allowed to call this API.
# Use * during local development. Restrict this to your real frontend
# domain (e.g. https://veda-pacharla060810.github.io) once deployed.
ALLOWED_ORIGIN=*

# No API key of any kind is required — the analyzer is a local
# keyword/pattern engine, not an AI model. There is nothing to pay for.
